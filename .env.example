# School ERPNext URL (required for npm run start / start:http)
X_ERPNEXT_URL=https://erp.livro.systems

# API key + secret (recommended; preferred over SID)
# Generate in ERPNext: User → API Access → Generate Keys
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Optional fallback if you are not using API keys
# ERPNEXT_SID=
